{
  "name": "@local/netease-music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Netease Cloud Music (网易云音乐) — a DeepSeek Harness desktop plugin: QR sign-in, daily recommendations, playlists, artists, search and an always-visible bottom player dock.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/*.png",
    "server/bridge.py",
    "README.md",
    "docs/CONTRACT.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "netease",
    "music",
    "player"
  ]
}
